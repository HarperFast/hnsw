{
	"name": "@harperfast/hnsw",
	"version": "0.2.0",
	"description": "Persistent, incrementally-maintained, concurrently-searchable native HNSW for Node.js: a memory-mapped fixed-slot graph file with off-event-loop search, seqlock concurrency, int8 asymmetric distance, and bitset/predicate filtering.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HarperFast/hnsw.git"
	},
	"main": "index.js",
	"types": "index.d.ts",
	"files": [
		"index.js",
		"index.d.ts",
		"hnsw-plane.node",
		"src",
		"build.rs",
		"build.mjs",
		"Cargo.toml",
		"Cargo.lock",
		"README.md",
		"DESIGN.md"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "node build.mjs",
		"install": "node build.mjs --if-needed",
		"test": "cargo test --release && node build.mjs && node smoke.mjs"
	},
	"keywords": [
		"hnsw",
		"ann",
		"vector",
		"nearest-neighbor",
		"similarity-search",
		"embedding",
		"mmap",
		"napi",
		"rust"
	],
	"optionalDependencies": {
		"@harperfast/hnsw-darwin-arm64": "0.2.0",
		"@harperfast/hnsw-linux-arm64-glibc": "0.2.0",
		"@harperfast/hnsw-linux-x64-glibc": "0.2.0",
		"@harperfast/hnsw-win32-x64": "0.2.0"
	}
}
